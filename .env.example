# Copy this file to .env and fill in your own Roboflow credentials.
# Never commit the populated .env file.

ROBOFLOW_API_KEY=replace_with_your_own_roboflow_api_key
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Set these to the model IDs shown in your Roboflow workspace.
# Format is usually: workspace-name/project-name/version
STOCK_MODEL_ID=your-workspace/your-stock-model/1
THEFT_MODEL_ID=your-workspace/your-theft-model/1
