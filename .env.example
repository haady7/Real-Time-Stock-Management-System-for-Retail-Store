# Copy this file to .env and provide your own private Roboflow settings.
# Never commit the populated .env file.

ROBOFLOW_API_KEY=replace_with_your_own_key
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Format: workspace/project/version
STOCK_MODEL_ID=your-workspace/your-stock-model/1
THEFT_MODEL_ID=your-workspace/your-activity-model/1
